# OneHome portal login (required)
ONEHOME_EMAIL=you@example.com
ONEHOME_PASSWORD=yourpassword

# Optional: email delivery of the workbook (used by `analyze --email-to`)
# For Gmail, create an App Password (Google Account → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=you@gmail.com
